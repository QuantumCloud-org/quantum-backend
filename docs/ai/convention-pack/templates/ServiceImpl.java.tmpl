// 模板占位：{{module}} 包名 · {{Entity}} 大驼峰 · {{entity}} 小驼峰 · {{ENTITY}} TableDef 常量名(全大写下划线)
//
// ⚠ 数据权限默认启用（fail-closed）。本模板的读/写侧校验是**默认开启**的，不是 TODO：
//   - 实体含部门维度（表有 dept_id 列）→ 原样保留全部 assert* 调用与辅助方法。
//   - 实体无部门维度且无行级敏感性 → 才允许删除 assert* 调用、辅助方法及 @DataScope/applyDataScope，
//     删除即视为显式豁免，必须在生成报告中输出一行 "data-scope-exempt: {{Entity}} <原因>"，
//     并在 validate.md 人工确认清单勾选（门禁会 grep 校验，见 validate.md）。
//   - 历史教训：2026-07-05 review 发现的 IDOR-read/write 正是"裸 getById/updateById"模式，勿回退。
package com.alpha.{{module}}.service.impl;

import com.alpha.framework.context.UserContext;
import com.alpha.framework.entity.LoginUser;
import com.alpha.framework.enums.ResultCode;
import com.alpha.framework.exception.BizException;
import com.alpha.orm.enums.DataScopeType;
import com.alpha.orm.interceptor.DataPermissionInterceptor;
import com.alpha.orm.permission.DataScope;
import com.alpha.{{module}}.domain.{{Entity}};
import com.alpha.{{module}}.dto.request.{{Entity}}Query;
import com.alpha.{{module}}.mapper.{{Entity}}Mapper;
import com.alpha.{{module}}.service.I{{Entity}}Service;
import com.mybatisflex.core.paginate.Page;
import com.mybatisflex.core.query.QueryWrapper;
import com.mybatisflex.spring.service.impl.ServiceImpl;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

import static com.alpha.{{module}}.domain.table.{{Entity}}TableDef.{{ENTITY}};

@Slf4j
@Service
@RequiredArgsConstructor
public class {{Entity}}ServiceImpl extends ServiceImpl<{{Entity}}Mapper, {{Entity}}> implements I{{Entity}}Service {

    @Override
    // ⚠ 默认 @DataScope（不带 type）= 按用户配置的数据权限；指定 type 是强制覆盖，
    //   会把配置为"全部数据"的用户也压到指定范围，仅在业务明确要求时使用。
    @DataScope
    public Page<{{Entity}}> selectPage({{Entity}}Query query) {
        QueryWrapper wrapper = buildQueryWrapper(query);
        DataPermissionInterceptor.applyDataScope(wrapper, "");
        return page(new Page<>(query.getPageNum(), query.getPageSize()), wrapper);
    }

    @Override
    public {{Entity}} selectById(Long id) {
        {{Entity}} entity = getById(id);
        if (entity == null) {
            throw new BizException("{{Entity}}不存在");
        }
        // 读侧数据权限：列表查询由 @DataScope 过滤，但按 ID 直达必须单独校验（防 IDOR-read）
        assertReadable(entity);
        return entity;
    }

    @Override
    @Transactional(rollbackFor = Exception.class)
    public Long insert({{Entity}} entity) {
        // TODO: 业务唯一性校验（名称/编码等，参照 SysUserServiceImpl.checkXxxUnique）
        // 写侧数据权限：只能在自己可见的部门下创建
        assertInDataScope(entity.getDeptId(), "新增");
        save(entity);
        return entity.getId();
    }

    @Override
    @Transactional(rollbackFor = Exception.class)
    public boolean update({{Entity}} entity) {
        {{Entity}} old = getById(entity.getId());
        if (old == null) {
            throw new BizException("{{Entity}}不存在");
        }
        // 写侧数据权限：目标记录必须在操作者范围内（防 IDOR-write）
        assertWritable(old);
        boolean ok = updateById(entity);
        if (!ok) {
            throw new BizException(ResultCode.DATA_CONFLICT, "数据已变更，请刷新后重试");
        }
        return true;
    }

    @Override
    @Transactional(rollbackFor = Exception.class)
    public boolean deleteByIds(List<Long> ids) {
        // 写侧数据权限：逐个校验后再删（防批量 IDOR-write）
        for (Long id : ids) {
            {{Entity}} entity = getById(id);
            if (entity != null) {
                assertWritable(entity);
            }
        }
        return removeByIds(ids);
    }

    private QueryWrapper buildQueryWrapper({{Entity}}Query query) {
        return QueryWrapper.create()
                // TODO: 按 query 字段拼接 .and({{ENTITY}}.FIELD.eq(...).when(...))
                .orderBy({{ENTITY}}.CREATE_TIME.desc());
    }

    // ==================== 数据权限辅助（语义对照 SysUserServiceImpl.isDeptInScope）====================

    private void assertReadable({{Entity}} target) {
        assertInDataScope(target.getDeptId(), "查看");
    }

    private void assertWritable({{Entity}} target) {
        assertInDataScope(target.getDeptId(), "操作");
    }

    /**
     * 校验目标部门是否在操作者数据权限范围内。fail-closed：无登录态 / SELF 范围一律拒绝。
     * SELF（仅本人）语义按 create_by 归属细化时，由具体业务在此方法内补充。
     */
    private void assertInDataScope(Long deptId, String action) {
        LoginUser current = UserContext.getUser();
        if (current == null) {
            throw new BizException(ResultCode.UNAUTHORIZED);
        }
        if (current.isAdmin()) {
            return;
        }
        boolean inScope = switch (DataScopeType.fromCode(current.getDataScope())) {
            case ALL -> true;
            case DEPT -> current.getDeptId() != null && current.getDeptId().equals(deptId);
            case DEPT_AND_CHILD, CUSTOM -> current.getDeptIds() != null && current.getDeptIds().contains(deptId);
            default -> false;
        };
        if (!inScope) {
            throw new BizException(ResultCode.ACCESS_DENIED, "无权" + action + "该部门数据");
        }
    }
}
